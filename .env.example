# Copy to .env and fill in YOUR values. .env is in .gitignore – never commit it.
# Load into the current terminal:  set -a; . ./.env; set +a

# ChatPlace API key (how to get it and which plan is needed: see the ChatPlace documentation)
CHATPLACE_API_KEY=cp_FAKE_replace_with_your_key
# ChatPlace bot ids: python3 skills/chatplace-funnels/scripts/chatplace.py bots
CHATPLACE_BOT_ID=00000000-0000-0000-0000-000000000000
CHATPLACE_TG_BOT_ID=00000000-0000-0000-0000-000000000000
# Only if your Telegram workspace in ChatPlace has a separate key (use with --key-env CHATPLACE_TG_API_KEY)
CHATPLACE_TG_API_KEY=

# Telegram bot token from @BotFather and the channel id (-100 + digits)
TELEGRAM_BOT_TOKEN=123456789:FAKE_replace_with_token_from_botfather
TELEGRAM_CHANNEL_ID=-100XXXXXXXXXX

# Optional: your own Shlink server for short links
SHLINK_BASE_URL=https://go.example.com
SHLINK_API_KEY=FAKE_replace_or_leave_empty

# Optional: Chromium/Chrome binary for skills/funnel-banners/scripts/render_banner.py --png
CHROME_BIN=
